# .env mẫu cho Supabase self-host (bộ github.com/supabase/supabase, thư mục docker/).
# Copy thành `.env` trong thư mục docker/ đã clone rồi ĐIỀN các giá trị bên dưới.
# Đây chỉ là các biến TỐI THIỂU + hay phải sửa; .env.example gốc của upstream còn nhiều
# biến khác — giữ nguyên chúng, chỉ đè những dòng dưới đây.
#
# LƯU Ý: key self-host KHÁC HẲN key cloud. ANON_KEY và SERVICE_ROLE_KEY là JWT ký bằng
# JWT_SECRET dưới đây — sinh theo hướng dẫn:
#   https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys

############################ Postgres ############################
POSTGRES_PASSWORD=thay-mat-khau-db-manh
POSTGRES_PORT=5432
# DB host/port nội bộ giữ mặc định của upstream (POSTGRES_HOST=db) — đừng đổi trừ khi biết rõ.

############################ JWT / API keys ############################
# >= 32 ký tự ngẫu nhiên. Đổi cái này = mọi phiên đăng nhập cũ hết hiệu lực.
JWT_SECRET=thay-chuoi-ngau-nhien-toi-thieu-32-ky-tu
JWT_EXPIRY=3600
# JWT ký bằng JWT_SECRET ở trên (role=anon / role=service_role). Sinh bằng link ở đầu file.
ANON_KEY=jwt-anon-sinh-tu-JWT_SECRET
SERVICE_ROLE_KEY=jwt-service-role-sinh-tu-JWT_SECRET

############################ URL công khai ############################
# Đổi <vps> thành IP/domain VPS self-host. Cổng 8000 = Kong (API gateway).
SITE_URL=http://<vps>:3000
API_EXTERNAL_URL=http://<vps>:8000
SUPABASE_PUBLIC_URL=http://<vps>:8000
# App/worker sẽ trỏ SUPABASE_URL vào chính API_EXTERNAL_URL này (xem FAILOVER.md mục 3–4).

############################ Cổng ############################
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

############################ Studio dashboard ############################
# (Studio bị profile-disable trong docker-compose.override.yml để tiết kiệm RAM —
#  vẫn giữ 2 biến này để .env khớp upstream, không gây lỗi thiếu biến.)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=thay-mat-khau-dashboard

############################ Auth (GoTrue) ############################
# Dự án chỉ cần ĐĂNG NHẬP, không đăng ký/quên mật khẩu → tắt signup cho gọn & an toàn.
# User được nạp từ dump (auth.users) nên vẫn đăng nhập được bằng mật khẩu cũ.
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=false
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
# Không dùng email provider (không gửi mail xác thực/khôi phục) — để trống SMTP mặc định upstream.

############################ Storage ############################
# Storage self-host mặc định lưu file trên đĩa (STORAGE_BACKEND=file). Bìa mirror sang đây
# theo FAILOVER.md mục 2. Nếu muốn S3 thật thì cấu hình theo .env.example upstream.

############################ Biến của SERVICE ĐÃ TẮT (giữ để khớp upstream) ############################
# Các service analytics(logflare)/vector/imgproxy/functions bị bỏ để vừa 4GB RAM
# (xem docker-compose.override.yml + FAILOVER.md). Những biến dưới CHỈ phục vụ chúng —
# KHÔNG cần khi trim, nhưng giữ lại (giá trị bất kỳ) để copy khớp .env gốc, tránh lỗi
# "variable is not set" khi compose parse file gốc.
LOGFLARE_PUBLIC_ACCESS_TOKEN=khong-dung-khi-trim
LOGFLARE_PRIVATE_ACCESS_TOKEN=khong-dung-khi-trim
# (Nếu .env.example upstream của ref bạn clone có thêm biến analytics khác — vd
#  LOGFLARE_API_KEY, DOCKER_SOCKET_LOCATION cho vector — cứ giữ nguyên giá trị mặc định.)
