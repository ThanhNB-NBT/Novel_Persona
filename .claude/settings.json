{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/migration-guard.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/commit-guard.sh",
            "if": "Bash(git commit*)",
            "timeout": 20,
            "statusMessage": "kiem luat truoc khi commit"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 -m py_compile:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(dart analyze:*)",
      "Bash(git ls-files:*)",
      "Bash(jq:*)"
    ],
    "ask": [
      "Bash(supabase db push:*)",
      "Bash(git tag:*)",
      "Bash(git push:*)"
    ]
  }
}